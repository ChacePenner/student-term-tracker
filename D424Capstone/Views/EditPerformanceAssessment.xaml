<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="D424Capstone.Views.EditPerformanceAssessment"
             Title="EditPerformanceAssessment"
             BackgroundColor="Beige">
    <VerticalStackLayout Padding="20" Spacing="20">
        <Label 
Text="Edit Performance Assessment"
FontSize="Large"
FontAttributes="Bold"
HorizontalOptions="Center" />

        <Label Text="Assessment Name" FontSize="Medium" FontAttributes="Bold"/>
        <Entry x:Name="PerformanceAssessmentNameEntry" Placeholder="Enter Assessment Name"/>

        <Label Text="Anticipated Start Date" FontSize="Medium" FontAttributes="Bold"/>
        <DatePicker x:Name="PerformanceAssessmentStartDatePicker"/>

        <Label Text="Due Date" FontSize="Medium" FontAttributes="Bold"/>
        <DatePicker x:Name="PerformanceAssessmentEndDatePicker"/>

        <HorizontalStackLayout Spacing="10" HorizontalOptions="CenterAndExpand">
            <Button 
    x:Name="cancelButton"
    Clicked="cancelButton_Clicked"
    Text="Cancel"
                BackgroundColor="LightCoral"
    />
            <Button 
    x:Name="saveButton"
    Clicked="saveButton_Clicked"
    Text="Save"
                BackgroundColor="ForestGreen"></Button>
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentPage>