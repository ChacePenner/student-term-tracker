<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="D424Capstone.Views.LoginPage"
             NavigationPage.HasNavigationBar="False">
    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Login" HorizontalOptions="CenterAndExpand" FontSize="Large" FontAttributes="Bold"></Label>
        <Entry x:Name="usernameEntry" x:FieldModifier="public" Placeholder="Username"/>
        <Entry x:Name="passwordEntry" x:FieldModifier="public" Placeholder="Password" IsPassword="True"/>
        <Button Text="Login" Clicked="loginButton_Clicked"/>
        <Button Text="Register" Clicked="registerButton_Clicked"/>
    </VerticalStackLayout>
</ContentPage>