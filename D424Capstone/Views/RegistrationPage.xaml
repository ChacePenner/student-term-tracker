<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="D424Capstone.Views.RegistrationPage"
             Title="Register"
             BackgroundColor="Beige">
    <VerticalStackLayout Padding="20" Spacing="15">
        <Entry x:Name="usernameEntry" Placeholder="Choose a Username" />
        <Entry x:Name="passwordEntry" Placeholder="Choose a Password" IsPassword="True" />
        <HorizontalStackLayout Spacing="10" Margin="0, 20, 0, 0" HorizontalOptions="Center">
            <Button Text="Cancel" Clicked="cancelButton_Clicked" BackgroundColor="LightCoral"/>
            <Button Text="Register" Clicked="RegisterButton_Clicked" BackgroundColor="ForestGreen"/>
        </HorizontalStackLayout>
        
    </VerticalStackLayout>
</ContentPage>
